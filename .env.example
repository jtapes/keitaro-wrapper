# Адрес и ключ Keitaro Admin API (ключ: Профиль -> API ключи в админке)
KEITARO_URL=https://tlgk.host
KEITARO_API_KEY=your_api_key_here
# Значения по умолчанию для создаваемых кампаний (можно выбрать в форме)
DEFAULT_DOMAIN_ID=1813
DEFAULT_GROUP_ID=10332
DEFAULT_TRAFFIC_SOURCE_ID=836
# Префикс имён кампаний: добавляется автоматически, если его нет в названии
CAMPAIGN_PREFIX=test_gorbachev_
DATABASE_URL=sqlite:///./wrapper.db
